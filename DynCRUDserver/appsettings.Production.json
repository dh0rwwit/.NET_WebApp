{
  "App": {
    "Name": "DynCRUDserver",
    "EnvironmentLabel": "Prod"
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },

  "AllowedHosts": "*",

  "ConnectionStrings": {
    "PostgresConnection": "",
    "OracleConnection": "",
    "SqlServerConnection": ""
  },

  "Cors": {
    "PolicyName": "DefaultCors",
    "AllowedOrigins": [
      "http://localhost:10000",
      "https://localhost:10001"
    ],
    "AllowedMethods": [ "GET", "POST", "PUT", "DELETE", "OPTIONS" ],
    "AllowedHeaders": [ "*" ],
    "AllowCredentials": false
  },
  // OnionASP의 Dynamic 호출 관련 메타 설정
  "PgDynamic": {
    "DefaultSchema": "pb",
    "AllowedSchemas": [ "pb" ],
    "MetaCacheSeconds": 300, // 컬럼 메타 캐시 유지 시간
    "EnableLogging": true // 동적 호출 로그 남길지 여부
  },
  // gRPC + REST 공통 옵션(필요시)
  "Grpc": {
    "EnableReflection": true,
    "MaxReceiveMessageSize": 4194304
  },

  "Kestrel": {
    "Endpoints": {
      "Http": { "Url": "http://localhost:1000" },
      "Https": { "Url": "https://localhost:1001" }
    }
  },
  // 예시: JWT 인증(나중에라도 쓸 수 있게 구조만 미리)
  "Jwt": {
    "Issuer": "OnionASP",
    "Audience": "OnionASPClient",
    "AccessTokenMinutes": 60
    // "SigningKey" 는 여기 말고 환경변수 / UserSecrets 로
  }
}


